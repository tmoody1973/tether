# Tether environment. Copy to .env.local for local dev; set the same names in Vercel for the deploy.
# Never commit real values. R = required in production (the app throws or refuses without it), O = optional, L = local only.
#
#   R  DATABASE_URL            Neon pooled Postgres URL (postgres://...). Local dev: pglite:./.pglite/dev. `next build` never connects to it.
#   R  APP_BASE_URL            Public origin, e.g. https://tether.vercel.app (no trailing slash). Used for PayPal return links; throws in production if unset.
#   R  TETHER_SIGNING_KEY      Long random secret that signs permission slips and Amara's session cookie. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   R  PAYPAL_CLIENT_ID        PayPal sandbox REST app credentials (charges, vault, month assistant, webhook verification).
#   R  PAYPAL_CLIENT_SECRET
#   R  PAYPAL_WEBHOOK_ID       Id of the sandbox webhook pointed at https://<host>/api/paypal/webhook (PAYMENT.CAPTURE.COMPLETED). The webhook returns 500 without it.
#   O  PAYPAL_BASE_URL         Defaults to the sandbox below. Keep it on the sandbox.
#   R  PAYPAL_DEMO_VAULT_ID    Amara's saved sandbox PayPal (vault id). Needed only to run scripts/seed.ts, not at runtime.
#   R  CHANNEL3_API_KEY        Product search for Zoe's shopping. Without it search/links/agent cannot run.
#   R  ANTHROPIC_API_KEY       Shopping agent and the month assistant. Without it the agent says it is switched off and the assistant says it can't see the month.
#   R  ALPACA_BROKER_KEY       Alpaca Broker sandbox (investing). Without them the Invest pages and investment approvals fail calmly.
#   R  ALPACA_BROKER_SECRET
#   O  ALPACA_FIRM_ACCOUNT_ID  Sandbox firm account for instant journal deposits. Unset = deposits go by bank transfer (ACH), which clears in minutes.
#   R  ALPACA_BROKER_BASE_URL  The sandbox broker host (below). No code default: Alpaca refuses to start without it.
#   O  ALPACA_DATA_BASE_URL    Defaults below (sandbox).
#   O  ALPACA_CUSTODIAL_ENABLED  "false" (default) = sandbox stand-in for a custodial account; "true" only if the sandbox supports real custodial accounts.
#   R  DEMO_GUARDIAN_KEY       Amara's key for the shared public demo (landing page buttons, Reset demo). Long random string; scripts/seed.ts creates the family with it.
#   R  DEMO_TEEN_TOKEN         Zoe's token for the shared demo. Long random string. Leave BOTH demo vars blank and the landing page hides the demo buttons.
#   O  NEXT_PUBLIC_ONESIGNAL_APP_ID  OneSignal app id (public). Shows Amara's "Turn on notifications" card on Home; unset hides it.
#   O  ONESIGNAL_REST_API_KEY  OneSignal REST key. SERVER ONLY, never in client code. Unset = push off (asks still work, nothing sent).
#   L  TETHER_E2E, CHANNEL3_BASE_URL, ALPACA_AUTH_URL   Local Playwright fakes only (Playwright sets them). Never set in production.
#
# Deploy order: set env -> `DATABASE_URL=<neon> pnpm tsx scripts/migrate.ts` -> deploy -> `pnpm tsx --env-file=.env.local scripts/seed.ts` -> add the webhook -> set PAYPAL_WEBHOOK_ID -> redeploy.

DATABASE_URL=
APP_BASE_URL=http://localhost:3000
TETHER_SIGNING_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_DEMO_VAULT_ID=
CHANNEL3_API_KEY=
ANTHROPIC_API_KEY=
ALPACA_BROKER_KEY=
ALPACA_BROKER_SECRET=
ALPACA_FIRM_ACCOUNT_ID=
ALPACA_BROKER_BASE_URL=https://broker-api.sandbox.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.sandbox.alpaca.markets
ALPACA_CUSTODIAL_ENABLED=false
DEMO_GUARDIAN_KEY=
DEMO_TEEN_TOKEN=
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
